            <div class="text-sm text-zinc-500">UIET, Panjab University · CGPA 8.32</div>
          </div>
          <div>
            <div class="text-xs uppercase tracking-wide text-zinc-500">Certifications</div>
            <ul class="text-sm text-zinc-600 dark:text-zinc-300 list-disc list-inside space-y-1">
              <li>
                <a href="https://verify.openedg.org/?id=Nx2U.3Y3u.LupQ" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 dark:hover:text-emerald-300 transition-colors">PCAP — Python Programming</a>
              </li>
              <li>
                <a href="https://www.coursera.org/account/accomplishments/verify/FLCJVNLF9XNY" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 dark:hover:text-emerald-300 transition-colors">Coursera — React</a>
                <span class="text-zinc-400"> / </span>
                <a href="https://coursera.org/verify/ZRZ3VB9S9TCS" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 dark:hover:text-emerald-300 transition-colors">Bootstrap 4</a>
              </li>
